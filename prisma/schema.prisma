generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
}

enum StatutCatalogue {
  ACTIF
  INACTIF
}

enum CommandeStatus{
  EN_ATTENTE           //PENDING 
  CONFIRMEE           //CONFIRMED 
  NEGOCIEE            // NEGOCED   
  LIVREE              //DELIVERED 
  ANNULEE             //CANCELLED
}
 
enum StatutLivraison {
  EN_PREPARATION
  EN_COURS
  LIVREE
  ANNULEE
}

model User {
  id_user    Int         @id @default(autoincrement())
  name       String
  email      String      @unique
  phone      String
  adress     String
  password   String
  role       Role        @default(USER)
  image      String?     @db.Text
  createdAt  DateTime    @default(now())
  updatedAt  DateTime?   @updatedAt

  conversation    Conversation[]    @relation("ConversationUsers")
  messages        Message[]
  commandes       Commande[]
  panier          Panier? 
}

model Type {
  id_type             Int        @id @default(autoincrement())
  nom_type            String     @unique
  description         String?    @db.Text
  date_creation_type  DateTime?  @default(now())

  categories          Category[]
}

model Category {
  id_categorie  Int            @id @default(autoincrement())
  nom_categorie String         @unique
  description   String?        @db.Text
  
  id_type       Int
  type          Type           @relation(fields: [id_type], references: [id_type])


  sous_categories SousCategory[]
}

model SousCategory {
  id_sous_categorie   Int       @id @default(autoincrement())
  nom_sous_categorie  String    @unique
  description         String?   @db.Text
  date_creation       DateTime? @default(now())

  id_categorie        Int
  category            Category  @relation(fields: [id_categorie], references: [id_categorie])

  products            Product[]
}

model Catalogue {
  id_catalogue      Int                  @id @default(autoincrement())
  nom_lien_pdf      String?              @db.Text
  statut            StatutCatalogue      @default(INACTIF)
  date_ajout        DateTime             @default(now())
}

model Product {
  id_produit         Int          @id @default(autoincrement())
  nom_produit        String
  description        String?       @db.Text
  prix               Decimal      @db.Decimal(10, 2)
  quantite_stock     Int
  image              String?
  date_ajout         DateTime     @default(now())
  type               String?

   is_active         Boolean       @default(true)

  id_sous_categorie  Int
  sous_category      SousCategory   @relation(fields: [id_sous_categorie], references: [id_sous_categorie])
  commandeItems      CommandeItem[]
  panierItems        PanierItem[]
}



model Commande{
  id_commande          Int                @id @default(autoincrement())
  id_user              Int

  total                Float 
  statut               CommandeStatus     @default(EN_ATTENTE)

  adresse_livraison    String
  ville                String
  region               String

  statut_livraison      StatutLivraison    @default(EN_PREPARATION)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  user                 User                @relation(fields: [id_user], references: [id_user])
  items                CommandeItem[]
} 


model CommandeItem{
  id_commandeItem         Int              @id @default(autoincrement())
  quantite                Int?              
  prix                    Float

  product_name_snapshot   String?
  product_price_snapshot  Float?

  id_commande             Int
  commande                Commande @relation(fields: [id_commande], references: [id_commande])

  id_produit             Int?
  product                Product? @relation(fields: [id_produit], references: [id_produit], onDelete: SetNull)

}

model Panier{
  id_panier Int   @id @default(autoincrement ())
  id_user   Int   @unique

  user      User  @relation(fields: [id_user], references: [id_user])

  items     PanierItem[]

}

model PanierItem{
  id_panierItem Int @id @default(autoincrement())

  id_panier     Int
  panier        Panier  @relation(fields: [id_panier], references: [id_panier])

  id_produit    Int
  product       Product @relation(fields: [id_produit], references: [id_produit])

  quantite      Int
}


model ActivityLog {
  id_activity          Int      @id @default(autoincrement())
  type                 String
  message              String
  entityType           String?
  entityId             Int?
  userId               Int?
  createdAt            DateTime @default(now())
}


model Conversation {
  id            String         @id @default(uuid())
  users         User[]         @relation("ConversationUsers")
  messages      Message[]
  createdAt     DateTime       @default(now())
}


model Message {
  id             String        @id @default(uuid())
  content        String
  senderId       Int
  conversationId String

  sender         User          @relation(fields: [senderId], references: [id_user])
  conversation   Conversation  @relation(fields: [conversationId], references: [id])

  isRead         Boolean      @default(false)
  readAt         DateTime?

  createdAt      DateTime      @default(now())
}
